      <fSuspensionLowerLimit value="-0.090000" />
      <fSuspensionRaise value="0.000000" />
      <fSuspensionBiasFront value="0.480000" />
      <fAntiRollBarForce value="2.000000" />
      <fAntiRollBarBiasFront value="0.580000" />
      <fRollCentreHeightFront value="0.380000" />
      <fRollCentreHeightRear value="0.380000" />

      <!-- DAMAGE MULTIPLIERS -->
      <fCollisionDamageMult value="0.100000" />
      <fWeaponDamageMult value="0.100000" />
      <fDeformationDamageMult value="0.100000" />
      <fEngineDamageMult value="0.000000" /> <!-- Mesin tidak bisa rusak -->

      <!-- FUEL & OIL -->
